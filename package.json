{
  "name": "veyrath",
  "version": "0.1.0",
  "private": true,
  "description": "Veyrath \u2014 multiplayer-first co-op action game (Milestone 1 network foundation)",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:desktop",
    "build:server": "npm run build -w @veyrath/game-server",
    "build:desktop": "npm run build -w @veyrath/desktop",
    "server": "npm run start -w @veyrath/game-server",
    "client": "npm run start -w @veyrath/desktop",
    "play:local": "npm run build && node scripts/play-local.mjs",
    "host": "npm run build && node scripts/host.mjs",
    "dev:web": "npm run dev -w @veyrath/client",
    "smoke:two": "npm run build && node scripts/smoke-two-clients.mjs",
    "smoke:packaged": "node scripts/smoke-two-clients.mjs --packaged",
    "smoke:lag": "npm run build && node scripts/smoke-two-clients.mjs --latency=120 --jitter=40 --loss=0.02",
    "soak": "npm run build:server && node scripts/soak.mjs",
    "metrics:report": "node scripts/metrics-report.mjs",
    "package:win": "npm run build && npm run package -w @veyrath/desktop && node scripts/copy-server-to-release.mjs",
    "package:friend": "npm run package:win && node scripts/package-friend.mjs",
    "typecheck": "tsc -p packages/sim && tsc -p packages/protocol && tsc -p services/game-server && tsc -p packages/client && tsc -p apps/desktop && tsc -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
