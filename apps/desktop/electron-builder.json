{
  "appId": "dev.veyrath.game",
  "productName": "Veyrath",
  "directories": {
    "output": "release"
  },
  "files": ["build/**/*", "!build/**/*.map", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "Veyrath-Setup-${version}.${ext}",
    "deleteAppDataOnUninstall": false
  },
  "publish": [
    {
      "provider": "generic",
      "url": "http://127.0.0.1:7777/updates/"
    }
  ],
  "extraMetadata": {
    "name": "veyrath"
  }
}
