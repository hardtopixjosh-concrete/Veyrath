# Game server (services/game-server). All optional.
# Bind address. 127.0.0.1 = this PC only; 0.0.0.0 = reachable from LAN / Tailscale.
VEYRATH_HOST=127.0.0.1
VEYRATH_PORT=7777
# How long a disconnected player's slot is held for rejoin (ms).
VEYRATH_RECONNECT_GRACE_MS=15000
# Send a snapshot every N simulation ticks (1 = 30 Hz at the fixed 30 Hz tick).
VEYRATH_SNAPSHOT_EVERY_TICKS=1
# debug | info | warn | error | silent
VEYRATH_LOG_LEVEL=info

# Desktop client. Default server URL shown in the lobby.
VEYRATH_SERVER_URL=ws://127.0.0.1:7777
